# Required — Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_token_here

# How old an incoming Telegram update may be before it is discarded (seconds).
# Telegram re-delivers queued updates after a restart; acting on stale commands
# confuses users. Must be a positive integer. Defaults to 60.
# MESSAGE_MAX_AGE_SECONDS=60

# For local development with SQLite — omit to use bot.sqlite
# DATABASE_URL=sqlite:///bot.sqlite

# For AWS Lambda — MySQL connection string
# DATABASE_URL=mysql+mysqlconnector://user:password@host:3306/dbname