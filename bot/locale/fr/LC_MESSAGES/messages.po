#: bot/SantaBot.py:154 bot/SantaBot.py:240 bot/SantaBot.py:405
msgid "You must send me this in a private chat"
msgstr "Vous devez m'envoyer ceci dans un chat privé"

#: bot/SantaBot.py:161
msgid "Use /address to share a mailing address, or /wish for wishlists."
msgstr ""
"Utilisez /address pour partager une adresse postale, ou /wish pour les "
"listes de souhaits."

#: bot/SantaBot.py:165
msgid "Hello! Lets get you setup!"
msgstr "Salut! Permet de vous installer!"

#: bot/SantaBot.py:172
msgid "You are already set up. I have your address as:"
msgstr "Vous êtes déjà configuré. J'ai votre adresse comme:"

#: bot/SantaBot.py:187
msgid "Command List:"
msgstr "Liste des commandes:"

#: bot/SantaBot.py:190
msgid "Shows this list of commands."
msgstr "Affiche cette liste de commandes."

#: bot/SantaBot.py:193
msgid "Sent only in a private message to begin personal setup."
msgstr ""
"Envoyé uniquement dans un message privé pour commencer la configuration "
"personnelle."

#: bot/SantaBot.py:196
msgid "Sent only in a group chat to enable the gift exchange."
msgstr ""
"Envoyé uniquement dans une discussion de groupe pour permettre l'échange "
"de cadeaux."

#: bot/SantaBot.py:199
msgid ""
"Sent only in a group chat by an admin to choose what this exchange "
"requires."
msgstr ""
"Envoyé uniquement dans un groupe, par un admin, pour choisir ce que cet "
"échange exige."

#: bot/SantaBot.py:202
msgid "Sent only in a private message to show and update your address."
msgstr ""
"Envoyé uniquement dans un message privé pour afficher et mettre à jour "
"votre adresse."

#: bot/SantaBot.py:205
msgid "Sent only in a private message to edit your wishlist for an exchange."
msgstr ""
"Envoyé uniquement en message privé pour modifier votre liste de souhaits "
"pour un échange."

#: bot/SantaBot.py:208
msgid "Joins you in the gift exchange in this chat."
msgstr "Vous rejoint dans l'échange de cadeaux dans ce chat."

#: bot/SantaBot.py:211
msgid "Gets the status of this chat's exchange."
msgstr "Obtient le statut de l'échange de ce chat."

#: bot/SantaBot.py:214
msgid "Prevents you from being paired up with this participant."
msgstr "Vous empêche d'être jumelé avec ce participant."

#: bot/SantaBot.py:217
msgid ""
"Removes block that was preventing you from being paired up with this "
"participant."
msgstr "Supprime le bloc qui vous empêchait d'être associé à ce participant."

#: bot/SantaBot.py:220
msgid "You will leave the gift exchange in this chat."
msgstr "Vous quitterez l'échange de cadeaux dans ce chat."

#: bot/SantaBot.py:224
msgid ""
"Begins the gift exchange by assigning a recipient to every participant, "
"then messaging them privately the details."
msgstr ""
"Commence l'échange de cadeaux en attribuant un destinataire à chaque "
"participant, puis en leur transmettant les détails en privé."

#: bot/SantaBot.py:229
msgid ""
"Resets the gift exchange by removing every participant's assigned "
"recipient."
msgstr ""
"Réinitialise l'échange de cadeaux en supprimant le destinataire attribué "
"à chaque participant."

#: bot/SantaBot.py:248 bot/SantaBot.py:410 bot/SantaBot.py:666
#, python-brace-format
msgid "Send me a {command} in a private message, then follow the instructions!"
msgstr ""
"Envoyez-moi une {command} dans un message privé, puis suivez les "
"instructions!"

#: bot/SantaBot.py:255
#, python-brace-format
msgid "I currently have your address as {address}"
msgstr "J'ai actuellement votre adresse en tant que {address}"

#: bot/SantaBot.py:257
msgid "If that is correct, you can ignore the following message."
msgstr "Si cela est correct, vous pouvez ignorer le message suivant."

#: bot/SantaBot.py:264
msgid "What is your address? (Reply to this message to change it)"
msgstr "Quelle est ton adresse? (Répondez à ce message pour le modifier)"

#: bot/SantaBot.py:299
msgid "OK, I have added your address as: "
msgstr "J'ai ajouté votre adresse comme: "

#: bot/SantaBot.py:302
#, python-brace-format
msgid "You can now to use {command} in any Telegram Secret Santa group!"
msgstr ""
"Vous pouvez maintenant utiliser {command} dans n'importe quel groupe "
"Telegram Père Noël Anonyme!"

#: bot/SantaBot.py:306
msgid "A Telegram Secret Santa group only needs to be activated once."
msgstr ""
"Un groupe Telegram Père Noël Anonyme ne doit être activé qu'une seule "
"fois."

#: bot/SantaBot.py:309
#, python-brace-format
msgid ""
"To do so, I must be a member of a telegram group and someone needs to "
"activate me with the command {command}"
msgstr ""
"Pour ce faire, je dois être membre d'un groupe de télégrammes et "
"quelqu'un doit m'activer avec la commande {command}"

#: bot/SantaBot.py:323
msgid "Unknown exchange"
msgstr "Échange inconnu"

#: bot/SantaBot.py:330 bot/SantaBot.py:335
#, python-brace-format
msgid "Exchange {id}"
msgstr "Échange {id}"

#: bot/SantaBot.py:389
msgid "Wishlist:"
msgstr "Liste de souhaits :"

#: bot/SantaBot.py:419
msgid ""
"You have not joined an exchange yet. Ask someone to run /hello in a "
"group, then use /join there."
msgstr ""
"Vous n'avez encore rejoint aucun échange. Demandez à quelqu'un de lancer "
"/hello dans un groupe, puis utilisez /join là-bas."

#: bot/SantaBot.py:439
msgid "Which exchange do you want to edit?"
msgstr "Quel échange voulez-vous modifier ?"

#: bot/SantaBot.py:450
#, python-brace-format
msgid "Your wishlist for {group}:"
msgstr "Votre liste de souhaits pour {group} :"

#: bot/SantaBot.py:452
#, python-brace-format
msgid "Your wishlist for {group} is empty."
msgstr "Votre liste de souhaits pour {group} est vide."

#: bot/SantaBot.py:454
msgid "Add an item"
msgstr "Ajouter un élément"

#: bot/SantaBot.py:456
msgid "Remove last"
msgstr "Supprimer le dernier"

#: bot/SantaBot.py:457
msgid "Clear"
msgstr "Vider"

#: bot/SantaBot.py:459
msgid "Share this list"
msgstr "Partager cette liste"

#: bot/SantaBot.py:493
msgid "Send me the item to add. (Reply to this message.)"
msgstr "Envoyez-moi l'élément à ajouter. (Répondez à ce message.)"

#: bot/SantaBot.py:521
msgid "Added."
msgstr "Ajouté."

#: bot/SantaBot.py:522
msgid "That was empty. Send the item again."
msgstr "C'était vide. Envoyez l'élément à nouveau."

#: bot/SantaBot.py:523
#, python-brace-format
msgid "That is too long. Keep each item under {limit} characters."
msgstr "C'est trop long. Gardez chaque élément sous {limit} caractères."

#: bot/SantaBot.py:526
msgid "That would make your wishlist too long to send in one message."
msgstr ""
"Votre liste de souhaits serait trop longue pour tenir dans un seul "
"message."

#: bot/SantaBot.py:527
#, python-brace-format
msgid "Your wishlist is full at {limit} items."
msgstr "Votre liste de souhaits est pleine, avec {limit} éléments."

#: bot/SantaBot.py:528
msgid "You are not part of that exchange any more."
msgstr "Vous ne faites plus partie de cet échange."

#: bot/SantaBot.py:529
msgid "That exchange no longer exists."
msgstr "Cet échange n'existe plus."

#: bot/SantaBot.py:531
msgid "That did not work. Try again."
msgstr "Cela n'a pas fonctionné. Réessayez."

#: bot/SantaBot.py:546 bot/SantaBot.py:626 bot/SantaBot.py:660
#: bot/SantaBot.py:786
msgid "You must begin from a group chat"
msgstr "Vous devez commencer à partir d'une discussion de groupe"

#: bot/SantaBot.py:549 bot/SantaBot.py:601
msgid "Only group admins can change exchange settings."
msgstr "Seuls les admins du groupe peuvent modifier les paramètres de l'échange."

#: bot/SantaBot.py:575
msgid "on"
msgstr "activé"

#: bot/SantaBot.py:575
msgid "off"
msgstr "désactivé"

#: bot/SantaBot.py:582
#, python-brace-format
msgid "Address required: {state}"
msgstr "Adresse requise : {state}"

#: bot/SantaBot.py:588
#, python-brace-format
msgid "Wishlist: {state}"
msgstr "Liste de souhaits : {state}"

#: bot/SantaBot.py:593
msgid "Exchange settings for this group:"
msgstr "Paramètres de l'échange pour ce groupe :"

#: bot/SantaBot.py:635
msgid "Hello! "
msgstr "Salut! "

#: bot/SantaBot.py:636
msgid ""
"This group chat now has the options of participating in a Secret Santa "
"Exchange!"
msgstr ""
"Ce chat de groupe offre désormais la possibilité de participer à un "
"échange de Père Noël Anonyme!"

#: bot/SantaBot.py:638
#, python-brace-format
msgid "{command} to participate"
msgstr "{command} pour participer"

#: bot/SantaBot.py:674 bot/SantaBot.py:793
#, python-brace-format
msgid "Someone must say {command} first!"
msgstr "Quelqu'un doit d'abord dire {command}!"

#: bot/SantaBot.py:677
msgid "OK, you're in!"
msgstr "Vous y êtes!"

#: bot/SantaBot.py:680
msgid "You have already joined!"
msgstr "Vous avez déjà rejoint!"

#: bot/SantaBot.py:702
msgid "Don't worry, you won't get yourself"
msgstr "Ne t'inquiète pas, tu ne te comprendras pas"

#: bot/SantaBot.py:705 bot/SantaBot.py:717
msgid "OK, you can no longer matched with that participant."
msgstr "Vous ne pouvez plus faire correspondre ce participant."

#: bot/SantaBot.py:708 bot/SantaBot.py:720
msgid "This blocked pairing has already been added."
msgstr "Cette association bloquée a déjà été ajoutée."

#: bot/SantaBot.py:714
msgid "This participant needs to join first"
msgstr "Ce participant doit d'abord s'inscrire"

#: bot/SantaBot.py:745 bot/SantaBot.py:754
#, python-brace-format
msgid "You can now be assigned to {name}"
msgstr "Vous pouvez maintenant être affecté à {name}"

#: bot/SantaBot.py:748 bot/SantaBot.py:757
#, python-brace-format
msgid "{name} was not blocked by you."
msgstr "{name} n'a pas été bloqué par vous."

#: bot/SantaBot.py:768 bot/SantaBot.py:771
msgid "You never joined"
msgstr "Tu n'as jamais rejoint"

#: bot/SantaBot.py:771
msgid "Done."
msgstr "Terminé."

#: bot/SantaBot.py:798
msgid "The exchange has not begun"
msgstr "L'échange n'a pas commencé"

#: bot/SantaBot.py:803
#, python-brace-format
msgid ""
"The exchange has finished, but {count} participant(s) were not messaged: "
"{names}"
msgstr ""
"L'échange est terminé, mais {count} participant(s) n'ont pas été "
"contactés : {names}"

#: bot/SantaBot.py:810
#, python-brace-format
msgid "Ask them to unblock the bot, then run {command} to resend."
msgstr "Demandez-leur de débloquer le bot, puis relancez {command}."

#: bot/SantaBot.py:814
msgid "The exchange has finished"
msgstr "L'échange est terminé"

#: bot/SantaBot.py:816
msgid "Joined Users:"
msgstr "Utilisateurs rejoints:"

#: bot/SantaBot.py:856
msgid "Cannot pair with: "
msgstr "Impossible de jumeler avec:"

#: bot/SantaBot.py:875
msgid "No one has Joined!"
msgstr "Personne n'a rejoint!"

#: bot/SantaBot.py:884
msgid "The exchange has already been setup!"
msgstr "L'échange est déjà configuré!"

#: bot/SantaBot.py:914
#, python-brace-format
msgid ""
"These participants have no wishlist: {names}. Run /start_exchange confirm"
" to start anyway."
msgstr ""
"Ces participants n'ont pas de liste de souhaits : {names}. Lancez "
"/start_exchange confirm pour démarrer quand même."

#: bot/SantaBot.py:927
msgid "Matching Impossible: 0 Permutations"
msgstr "Correspondance impossible: 0 permutations"

#: bot/SantaBot.py:958
msgid "Messages have been sent!"
msgstr "Des messages ont été envoyés!"

#: bot/SantaBot.py:964
#, python-brace-format
msgid ""
"Could not message: {names}. Ask them to unblock the bot, then run "
"{command} again."
msgstr ""
"Impossible de contacter : {names}. Demandez-leur de débloquer le bot, "
"puis relancez {command}."

#: bot/SantaBot.py:1024
#, python-brace-format
msgid "You got {username}!"
msgstr "Vous avez {username}!"

#: bot/SantaBot.py:1029
#, python-brace-format
msgid "Their address is: {address}."
msgstr "Leur adresse est: {address}."

#: bot/SantaBot.py:1034
msgid "Their wishlist:"
msgstr "Leur liste de souhaits :"

#: bot/SantaBot.py:1041
msgid "All pairings have been reset"
msgstr "Tous les appariements ont été réinitialisés"

