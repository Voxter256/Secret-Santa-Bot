#: bot/SantaBot.py:164 bot/SantaBot.py:253 bot/SantaBot.py:417
msgid "You must send me this in a private chat"
msgstr "Você deve me enviar isso em um bate-papo privado"

#: bot/SantaBot.py:171
msgid "Use /address to share a mailing address, or /wish for wishlists."
msgstr ""
"Use /address para compartilhar um endereço postal, ou /wish para listas "
"de desejos."

#: bot/SantaBot.py:175
msgid "Hello! Lets get you setup!"
msgstr "Olá! Vamos pegar sua configuração!"

#: bot/SantaBot.py:182
msgid "You are already set up. I have your address as:"
msgstr "Você já está configurado. Eu tenho seu endereço como:"

#: bot/SantaBot.py:197
msgid "Command List:"
msgstr "Command List:"

#: bot/SantaBot.py:200
msgid "Shows this list of commands."
msgstr "Mostra esta lista de comandos."

#: bot/SantaBot.py:203
msgid "Sent only in a private message to begin personal setup."
msgstr ""
"Enviado apenas em uma mensagem privada para iniciar a configuração "
"pessoal."

#: bot/SantaBot.py:206
msgid "Sent only in a group chat to enable the gift exchange."
msgstr "Enviado somente em um bate-papo em grupo para ativar a troca de presentes."

#: bot/SantaBot.py:209
msgid ""
"Sent only in a group chat by an admin to choose what this exchange "
"requires."
msgstr ""
"Enviado apenas em um grupo, por um administrador, para escolher o que "
"esta troca exige."

#: bot/SantaBot.py:212
msgid "Sent only in a private message to show and update your address."
msgstr "Enviou apenas uma mensagem privada para mostrar e atualizar seu endereço."

#: bot/SantaBot.py:215
msgid "Sent only in a private message to edit your wishlist for an exchange."
msgstr ""
"Enviado apenas em uma mensagem privada para editar sua lista de desejos "
"de uma troca."

#: bot/SantaBot.py:218
msgid "Joins you in the gift exchange in this chat."
msgstr "Junta-te a ti na troca de presentes neste chat."

#: bot/SantaBot.py:221
msgid "Gets the status of this chat's exchange."
msgstr "Obtém o status da troca deste bate-papo."

#: bot/SantaBot.py:224
msgid "Prevents you from being paired up with this participant."
msgstr "Impede que você seja emparelhado com este participante."

#: bot/SantaBot.py:227
msgid ""
"Removes block that was preventing you from being paired up with this "
"participant."
msgstr ""
"Remove o bloqueio que estava impedindo você de ser emparelhado com este "
"participante."

#: bot/SantaBot.py:230
msgid "You will leave the gift exchange in this chat."
msgstr "Você vai deixar a troca de presentes neste chat."

#: bot/SantaBot.py:234
msgid ""
"Begins the gift exchange by assigning a recipient to every participant, "
"then messaging them privately the details."
msgstr ""
"Começa a troca de presentes atribuindo um destinatário a cada "
"participante, depois enviando os detalhes em particular."

#: bot/SantaBot.py:239
msgid ""
"Resets the gift exchange by removing every participant's assigned "
"recipient."
msgstr ""
"Redefine a troca de presentes removendo o destinatário atribuído de cada "
"participante."

#: bot/SantaBot.py:242
msgid "Sends a problem report or suggestion about the bot."
msgstr ""

#: bot/SantaBot.py:261 bot/SantaBot.py:422 bot/SantaBot.py:678
#, python-brace-format
msgid "Send me a {command} in a private message, then follow the instructions!"
msgstr "Envie - me um {command} em uma mensagem privada e siga as instruções!"

#: bot/SantaBot.py:268
#, python-brace-format
msgid "I currently have your address as {address}"
msgstr "Atualmente tenho seu endereço como {address}"

#: bot/SantaBot.py:270
msgid "If that is correct, you can ignore the following message."
msgstr "Se isso estiver correto, você pode ignorar a seguinte mensagem."

#: bot/SantaBot.py:277
msgid "What is your address? (Reply to this message to change it)"
msgstr "Qual é o seu endereço? (Responda a esta mensagem para alterá-la)"

#: bot/SantaBot.py:312
#, fuzzy, python-brace-format
msgid "OK, I have added your address as {address}."
msgstr "Eu adicionei seu endereço como: "

#: bot/SantaBot.py:314
#, python-brace-format
msgid "You can now to use {command} in any Telegram Secret Santa group!"
msgstr "Agora você pode usar {command} em qualquer grupo Telegram Secret Santa!"

#: bot/SantaBot.py:318
msgid "A Telegram Secret Santa group only needs to be activated once."
msgstr "Um grupo Telegram Secret Santa só precisa ser ativado uma vez."

#: bot/SantaBot.py:321
#, python-brace-format
msgid ""
"To do so, I must be a member of a telegram group and someone needs to "
"activate me with the command {command}"
msgstr ""
"Para fazer isso, eu devo ser um membro de um grupo de telegramas e alguém"
" precisa me ativar com o comando {command}"

#: bot/SantaBot.py:335
msgid "Unknown exchange"
msgstr "Troca desconhecida"

#: bot/SantaBot.py:342 bot/SantaBot.py:347
#, python-brace-format
msgid "Exchange {id}"
msgstr "Troca {id}"

#: bot/SantaBot.py:401
msgid "Wishlist:"
msgstr "Lista de desejos:"

#: bot/SantaBot.py:431
msgid ""
"You have not joined an exchange yet. Ask someone to run /hello in a "
"group, then use /join there."
msgstr ""
"Você ainda não entrou em nenhuma troca. Peça para alguém executar /hello "
"em um grupo e use /join lá."

#: bot/SantaBot.py:451
msgid "Which exchange do you want to edit?"
msgstr "Qual troca você quer editar?"

#: bot/SantaBot.py:462
#, python-brace-format
msgid "Your wishlist for {group}:"
msgstr "Sua lista de desejos para {group}:"

#: bot/SantaBot.py:464
#, python-brace-format
msgid "Your wishlist for {group} is empty."
msgstr "Sua lista de desejos para {group} está vazia."

#: bot/SantaBot.py:466
msgid "Add an item"
msgstr "Adicionar item"

#: bot/SantaBot.py:468
msgid "Remove last"
msgstr "Remover o último"

#: bot/SantaBot.py:469
msgid "Clear"
msgstr "Limpar"

#: bot/SantaBot.py:471
msgid "Share this list"
msgstr "Compartilhar esta lista"

#: bot/SantaBot.py:505
msgid "Send me the item to add. (Reply to this message.)"
msgstr "Envie o item que deseja adicionar. (Responda a esta mensagem.)"

#: bot/SantaBot.py:533
msgid "Added."
msgstr "Adicionado."

#: bot/SantaBot.py:534
msgid "That was empty. Send the item again."
msgstr "Isso estava vazio. Envie o item novamente."

#: bot/SantaBot.py:535
#, python-brace-format
msgid "That is too long. Keep each item under {limit} characters."
msgstr "Isso é longo demais. Mantenha cada item com menos de {limit} caracteres."

#: bot/SantaBot.py:538
msgid "That would make your wishlist too long to send in one message."
msgstr "Sua lista de desejos ficaria longa demais para uma única mensagem."

#: bot/SantaBot.py:539
#, python-brace-format
msgid "Your wishlist is full at {limit} items."
msgstr "Sua lista de desejos está cheia, com {limit} itens."

#: bot/SantaBot.py:540
msgid "You are not part of that exchange any more."
msgstr "Você não faz mais parte dessa troca."

#: bot/SantaBot.py:541
msgid "That exchange no longer exists."
msgstr "Essa troca não existe mais."

#: bot/SantaBot.py:543
msgid "That did not work. Try again."
msgstr "Não funcionou. Tente novamente."

#: bot/SantaBot.py:558 bot/SantaBot.py:639 bot/SantaBot.py:672
#: bot/SantaBot.py:798
msgid "You must begin from a group chat"
msgstr "Você deve começar de um bate-papo em grupo"

#: bot/SantaBot.py:561 bot/SantaBot.py:614
msgid "Only group admins can change exchange settings."
msgstr "Somente administradores do grupo podem alterar as configurações da troca."

#: bot/SantaBot.py:595
#, python-brace-format
msgid "Address required: {state}"
msgstr "Endereço obrigatório: {state}"

#: bot/SantaBot.py:601
#, python-brace-format
msgid "Wishlist: {state}"
msgstr "Lista de desejos: {state}"

#: bot/SantaBot.py:606
msgid "Exchange settings for this group:"
msgstr "Configurações da troca deste grupo:"

#: bot/SantaBot.py:648
#, fuzzy
msgid ""
"Hello! This group chat now has the options of participating in a Secret "
"Santa Exchange!"
msgstr ""
"Este bate-papo em grupo agora tem a opção de participar de um Secret "
"Santa Exchange!"

#: bot/SantaBot.py:650
#, python-brace-format
msgid "{command} to participate"
msgstr "{command} para participar"

#: bot/SantaBot.py:686 bot/SantaBot.py:805
#, python-brace-format
msgid "Someone must say {command} first!"
msgstr "Alguém deve {command} primeiro!"

#: bot/SantaBot.py:689
msgid "OK, you're in!"
msgstr "Você está dentro!"

#: bot/SantaBot.py:692
msgid "You have already joined!"
msgstr "Você já se juntou!"

#: bot/SantaBot.py:714
msgid "Don't worry, you won't get yourself"
msgstr "Não se preocupe, você não vai conseguir"

#: bot/SantaBot.py:717 bot/SantaBot.py:729
msgid "OK, you can no longer matched with that participant."
msgstr "OK, você não pode mais corresponder a esse participante."

#: bot/SantaBot.py:720 bot/SantaBot.py:732
msgid "This blocked pairing has already been added."
msgstr "Este par bloqueado já foi adicionado."

#: bot/SantaBot.py:726
msgid "This participant needs to join first"
msgstr "Este participante precisa participar primeiro"

#: bot/SantaBot.py:757 bot/SantaBot.py:766
#, python-brace-format
msgid "You can now be assigned to {name}"
msgstr "Agora você pode ser atribuído a {name}"

#: bot/SantaBot.py:760 bot/SantaBot.py:769
#, python-brace-format
msgid "{name} was not blocked by you."
msgstr "{name} não foi bloqueado por você."

#: bot/SantaBot.py:780 bot/SantaBot.py:783
msgid "You never joined"
msgstr "Você nunca se juntou"

#: bot/SantaBot.py:783
msgid "Done."
msgstr "Feito."

#: bot/SantaBot.py:810
msgid "The exchange has not begun"
msgstr "A troca não começou"

#: bot/SantaBot.py:815
#, python-brace-format
msgid ""
"The exchange has finished, but {count} participant(s) were not messaged: "
"{names}"
msgstr "A troca terminou, mas {count} participante(s) não foram avisados: {names}"

#: bot/SantaBot.py:822
#, python-brace-format
msgid "Ask them to unblock the bot, then run {command} to resend."
msgstr "Peça para desbloquearem o bot e execute {command} novamente."

#: bot/SantaBot.py:826
msgid "The exchange has finished"
msgstr "A troca terminou"

#: bot/SantaBot.py:828
msgid "Joined Users:"
msgstr "Usuários Ingressados"

#: bot/SantaBot.py:865
#, fuzzy, python-brace-format
msgid "Cannot pair with: {names}"
msgstr "Não foi possível emparelhar com: "

#: bot/SantaBot.py:880
msgid "No one has Joined!"
msgstr "Ninguém se juntou!"

#: bot/SantaBot.py:889
msgid "The exchange has already been setup!"
msgstr "A troca já foi configurada!"

#: bot/SantaBot.py:919
#, python-brace-format
msgid ""
"These participants have no wishlist: {names}. Run /start_exchange confirm"
" to start anyway."
msgstr ""
"Estes participantes não têm lista de desejos: {names}. Execute "
"/start_exchange confirm para começar mesmo assim."

#: bot/SantaBot.py:932
msgid "Matching Impossible: 0 Permutations"
msgstr "O emparelhamento é impossível: 0 combinações potenciais"

#: bot/SantaBot.py:963
msgid "Messages have been sent!"
msgstr "Mensagens foram enviadas!"

#: bot/SantaBot.py:969
#, python-brace-format
msgid ""
"Could not message: {names}. Ask them to unblock the bot, then run "
"{command} again."
msgstr ""
"Não foi possível avisar: {names}. Peça para desbloquearem o bot e execute"
" {command} novamente."

#: bot/SantaBot.py:1029
#, python-brace-format
msgid "You got {username}!"
msgstr "Você tem {username}!"

#: bot/SantaBot.py:1034
#, python-brace-format
msgid "Their address is: {address}."
msgstr "O endereço deles é: {address}."

#: bot/SantaBot.py:1039
msgid "Their wishlist:"
msgstr "A lista de desejos da pessoa:"

#: bot/SantaBot.py:1046
msgid "All pairings have been reset"
msgstr "Todos os pares foram redefinidos"

#: bot/SantaBot.py:1242
msgid ""
"Send feedback with /feedback <message>. For example: /feedback the "
"exchange finished but I never got my partner."
msgstr ""

#: bot/SantaBot.py:1250
#, fuzzy, python-brace-format
msgid "That is too long. Please keep feedback under {max} characters."
msgstr "Isso é longo demais. Mantenha cada item com menos de {limit} caracteres."

#: bot/SantaBot.py:1262
msgid "Sorry, I could not save that. Please try again."
msgstr ""

#: bot/SantaBot.py:1280
msgid "Thanks, I saved your feedback."
msgstr ""

